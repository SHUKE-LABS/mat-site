---
import { LEMONSQUEEZY_CHECKOUT } from '../config/pricing';
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold text-ink">
      <img
        src="/images/my-ai-team-logo.png"
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 rounded-lg object-contain"
      />
      My AI Team
    </a>
    <nav class="flex items-center gap-5 text-sm text-muted">
      <!-- In-page anchors are redundant on a phone, where the whole page is a
           short scroll — drop them rather than wrap the bar onto two lines.
           Docs is dropped with them: the full wordmark ("My AI Team") plus the
           CTA no longer fit on a 320-360px bar, and the footer, the hero's
           "Read the docs" button and the body copy still link to the docs. -->
      <a class="hidden hover:text-ink transition-colors sm:inline" href="/#modes">Session modes</a>
      <a class="hidden hover:text-ink transition-colors sm:inline" href="/#plans">Pricing</a>
      <a class="hidden hover:text-ink transition-colors sm:inline" href="https://mat-docs.shukelabs.com">Docs</a>
      <a
        class="shrink-0 rounded-lg bg-accent px-4 py-2 font-medium text-white transition-colors hover:bg-accent-hover"
        href={LEMONSQUEEZY_CHECKOUT}>Get a license</a
      >
    </nav>
  </div>
</header>
